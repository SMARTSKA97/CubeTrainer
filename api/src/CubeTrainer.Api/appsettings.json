{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Postgres": "" },
  "Cors": { "Origins": [ "http://localhost:4200" ] },
  "Proxy": { "TrustForwardedHeaders": false },
  "RateLimiting": { "PermitPerMinute": 300, "AuthPermitPerMinute": 20 },
  "Auth": { "MinimumAge": 13, "RequireConfirmedEmail": true, "TermsVersion": "2026-10", "Cookie": { "SameSite": "Lax" } },
  "Web": { "BaseUrl": "http://localhost:4200" },
  "Email": { "Provider": "Log", "FromAddress": "no-reply@localhost", "FromName": "CubeTrainer" },
  "Persistence": { "AllowInMemory": false }
}
