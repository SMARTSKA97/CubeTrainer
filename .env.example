# Copy to .env (git-ignored). Used by: docker compose -f infra/docker-compose.yml up --build
# Everything here is optional for local use; production values live in Render / GitHub / Cloudflare.

POSTGRES_PASSWORD=cube

# Leave empty to use the built-in development keys. Never reuse these values in production.
# openssl rand -base64 64
JWT_SIGNING_KEY=
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# true = reject passwords found in the Have I Been Pwned breach list (needs internet access from the API container)
CHECK_BREACHED_PASSWORDS=false

# Social login while testing locally. Redirect URL to register with the provider:
#   http://localhost:8080/api/v1/auth/external/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
